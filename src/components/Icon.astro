---
import type { HTMLAttributes } from "astro/types";

// Inline Font Awesome SVGs: no icon font or stylesheet blocking the first paint.
// To use a new icon, add its name to the list of its family.
const svgs = import.meta.glob<string>(
	[
		"/node_modules/@fortawesome/fontawesome-free/svgs/solid/{arrow-right,arrow-up-right-from-square,building,camera,camera-retro,check,chevron-left,chevron-right,circle-check,desktop,envelope,globe,history,images,language,laptop,leaf,lightbulb,location-dot,magnifying-glass,moon,paper-plane,phone,plane-arrival,plane-departure,route,shield-halved,spinner,sun,user,xmark}.svg",
		"/node_modules/@fortawesome/fontawesome-free/svgs/regular/{image}.svg",
		"/node_modules/@fortawesome/fontawesome-free/svgs/brands/{facebook-f,google,instagram,whatsapp}.svg",
	],
	{ query: "?raw", import: "default", eager: true },
);

interface Props extends HTMLAttributes<"svg"> {
	/** Font Awesome classes, e.g. "fa-solid fa-phone" or "fa-brands fa-instagram" */
	name: string;
}

const { name, class: className, ...attrs } = Astro.props;

const families: Record<string, string> = {
	"fa-solid": "solid",
	"fa-regular": "regular",
	"fa-brands": "brands",
};
const tokens = name.split(/\s+/);
const family = tokens.map((t) => families[t]).find(Boolean) ?? "solid";
const spin = tokens.includes("fa-spin");
const icon = tokens
	.find((t) => t.startsWith("fa-") && !families[t] && t !== "fa-spin")
	?.slice(3);

const svg = svgs[`/node_modules/@fortawesome/fontawesome-free/svgs/${family}/${icon}.svg`];
if (!svg) {
	throw new Error(`Icono "${name}" no disponible: añádelo a la lista de src/components/Icon.astro`);
}
const [, viewBox, body] = svg.match(/viewBox="([^"]+)"[^>]*>([\s\S]*)<\/svg>/) ?? [];
---

<svg
	viewBox={viewBox}
	class:list={["icon", { spin }, className]}
	aria-hidden="true"
	focusable="false"
	{...attrs}
	set:html={body}
/>

<style>
	.icon {
		box-sizing: content-box;
		display: inline-block;
		height: 1em;
		width: 1.25em;
		overflow: visible;
		vertical-align: -0.125em;
	}

	.spin {
		animation: icon-spin 2s linear infinite;
	}

	@keyframes icon-spin {
		to {
			transform: rotate(1turn);
		}
	}
</style>
