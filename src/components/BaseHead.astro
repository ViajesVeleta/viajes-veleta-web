---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { BUSINESS, DEFAULT_OG_IMAGE, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl } from "../i18n/utils";
import { publishedLanguages } from "../i18n/ui";
import { toMetaDescription, withTrailingSlash } from "../utils/seo";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | null;
	// Language-specific images for social media sharing
	imageEs?: ImageMetadata;
	imageEn?: ImageMetadata;
	imageAlt?: string;
	type?: "website" | "article";
	noindex?: boolean;
	translatedPaths?: Record<string, string>;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	image,
	imageEs,
	imageEn,
	imageAlt,
	type = "website",
	noindex = false,
	translatedPaths,
	jsonLd,
} = Astro.props;

const canonicalURL = new URL(withTrailingSlash(Astro.url.pathname), Astro.site);
const lang = getLangFromUrl(Astro.url);
const metaDescription = toMetaDescription(description);

const localizedImage =
	lang === "es" ? imageEs || image : lang === "en" ? imageEn || image : image;
const ogImage = localizedImage
	? {
			src: localizedImage.src,
			width: localizedImage.width,
			height: localizedImage.height,
			type: `image/${localizedImage.format === "jpg" ? "jpeg" : localizedImage.format}`,
			alt: imageAlt || title,
		}
	: DEFAULT_OG_IMAGE;
const ogImageURL = new URL(ogImage.src, Astro.site);

const alternates = Object.entries(translatedPaths ?? {}).filter(([l]) =>
	publishedLanguages.includes(l),
);
const hasAlternates = alternates.length > 1;

const organization = {
	"@context": "https://schema.org",
	"@type": "TravelAgency",
	"@id": new URL("/#organization", Astro.site).href,
	name: BUSINESS.name,
	description: SITE_DESCRIPTION,
	url: new URL("/", Astro.site).href,
	logo: new URL("/icon-512.png", Astro.site).href,
	image: new URL(DEFAULT_OG_IMAGE.src, Astro.site).href,
	telephone: BUSINESS.telephone,
	email: BUSINESS.email,
	address: {
		"@type": "PostalAddress",
		streetAddress: BUSINESS.streetAddress,
		addressLocality: BUSINESS.addressLocality,
		addressRegion: BUSINESS.addressRegion,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.addressCountry,
	},
	sameAs: BUSINESS.sameAs,
};
const structuredData = [organization, ...(jsonLd ? [jsonLd].flat() : [])];
---

<ClientRouter />

